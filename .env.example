# Storage driver: "local" (default) reads ./projects from disk.
# "static" serves projects generated into public/static-projects straight from the CDN (hosted demo).
# "remote" reads metadata + tiles from a public base URL (e.g. Cloudflare R2 custom domain).
VIEWER_STORAGE_DRIVER=local

# local driver: directory that holds <projectId>/project.json (default: ./projects)
# VIEWER_STORAGE_DIR=./projects

# remote driver: public base URL that mirrors the ./projects layout (tiles, project.json, artwork.dzi)
# VIEWER_ASSET_BASE_URL=https://artwork-assets.example.com/projects

# remote driver: base URL for original PNGs (ideally a private bucket behind signed URLs).
# Defaults to VIEWER_ASSET_BASE_URL.
# VIEWER_ORIGINALS_BASE_URL=https://artwork-originals.example.com/projects

# Optional: redirect the home page, e.g. to the demo on a public showcase deployment.
# VIEWER_HOME_REDIRECT=/viewer/demo
