{
  "name": "loupe",
  "version": "0.1.0",
  "private": true,
  "description": "Deep-zoom viewer for huge print artwork: WebP tile pyramids + OpenSeadragon, with a one-click download of the untouched original PNG.",
  "license": "MIT",
  "author": "Siam Parvez <hello@siamparvez.com> (https://siamparvez.com)",
  "homepage": "https://github.com/siam-parvez/loupe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siam-parvez/loupe.git"
  },
  "bugs": {
    "url": "https://github.com/siam-parvez/loupe/issues"
  },
  "keywords": [
    "deep-zoom",
    "openseadragon",
    "dzi",
    "image-viewer",
    "nextjs",
    "sharp",
    "print",
    "artwork"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "tsx scripts/generate-demo.ts --if-missing",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "viewer:prepare": "tsx scripts/prepare-image.ts",
    "viewer:demo": "tsx scripts/generate-demo.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "openseadragon": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
